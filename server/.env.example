# ─── Database (MySQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=sm
DB_PASSWORD=your_db_password
DB_NAME=sm
# Set to true for cloud MySQL providers that require TLS
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CONNECTION_LIMIT=10

# ─── Auth ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me

# ─── Server ──────────────────────────────────────────
# Render sets PORT automatically
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# Optional: absolute path for uploaded images (e.g. a Render persistent disk mount)
# UPLOAD_DIR=/var/data/uploads
